# Models live outside the repo -- never commit multi-GB GGUFs
*.gguf

# Scratch
*.tmp
*.swp

# Generated sites: keep the source (it's quality evidence), never the deps
sites/*/*/node_modules/
sites/*/.pi-agent/sessions/

# nsys sqlite exports are regenerable from the .nsys-rep
results/phase0/nsys/*.sqlite
__pycache__/
results/p2-step0/*.sqlite
results/p2-step0/*.qdstrm
results/h40-trace/*.sqlite
results/h40-trace/*.qdstrm
